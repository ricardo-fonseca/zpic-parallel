If:
  PathMatch: .*\.(cu|cuh)$
CompileFlags:
  Add:
    - -xcuda
    - -std=c++20
    - --cuda-gpu-arch=sm_80
    - --cuda-path=/opt/nvidia/hpc_sdk/Linux_x86_64/26.9/cuda/

---

CompileFlags:
  Add:
    - -std=c++20
    - -I/opt/nvidia/hpc_sdk/Linux_x86_64/26.9/comm_libs/13.3/hpcx/hpcx-2.50/ompi5/include
    - -I/opt/nvidia/hpc_sdk/Linux_x86_64/26.9/cuda/13.3/targets/x86_64-linux/include
    - -I../common
    - -I../zdf

Documentation:
  CommentFormat: Doxygen
